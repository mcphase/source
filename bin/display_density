#!/bin/bash

echo "#---------------------------------------------------------"
echo "#display_density: graphic package to display ionic density"
echo "#---------------------------------------------------------"
echo "arguments as for densplt:"
if test -f results/densplt.jvx
 then
  rm results/densplt.jvx
 fi

if test -f results/graphic_parameters.gp
 then
 echo "# using preset graphic parameters from file results/graphic_parameters.gp"
 else
 echo "# this is initial graphic parameters file" > results/graphic_parameters.gp
fi
i=0
while [ $i -eq 0 ]
do
  densplt $*
if test -f results/densplt.jvx
then
  java JvxAnimator results/densplt.jvx &
 rem1=$!
 java displaycontour 2 3 4 results/densplti.grid &
 rem2=$!
 java displaycontour 1 3 4 results/denspltj.grid &
 rem3=$!
  java displaycontour 1 2 4 results/denspltk.grid &
 rem4=$!
 cp results/graphic_parameters.gp results/.graphic_parameters.gp
 
 java graphic_parameters_configurator 
 # if graphic_parameters_configurator wants to exit,
  #  it deletes results/graphic_parameters.gp - check and put i=1 to exit 
  if [ ! -f results/graphic_parameters.gp ]
   then
    i=1
    cp results/.graphic_parameters.gp results/graphic_parameters.gp
  fi
 kill $rem1
 kill $rem2
 kill $rem3
 kill $rem4
else
  i=1
fi
done

