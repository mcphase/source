#!/bin/bash

echo "#--------------------------------------------------------------"
echo "# display_densities: graphic package to display chargedensities"
echo "#--------------------------------------------------------------"
echo "#arguments as for spins:"
if test -f results/spins.jvx
 then
  rm results/spins.jvx
fi
if test -f results/spins.01.jvx
 then
  rm results/spins.01.jvx
fi

if test -f results/graphic_parameters.set
 then
 echo "# using preset graphic parameters from file results/graphic_parameters.set"
 cp results/graphic_parameters.set results/.graphic_parameters.set
 else
 echo "# this is initial graphic parameters file" > results/graphic_parameters.set
fi

while test -f results/graphic_parameters.set
do
 spins $*
if test -f results/spins.jvx
then
java JvxAnimator results/spins.jvx &
rem1=$!

if test -f results/spins_prim.jvx
then
java JvxAnimator results/spins_prim.jvx &
rem2=$!
fi

if test -f results/spins_prim.01.jvx
then
java JvxAnimator "results/spins_prim.*.jvx"  &
rem3=$!
fi

if test -f results/spins.01.jvx
then
java JvxAnimator "results/spins.*.jvx"  &
rem4=$!
fi


 java graphic_parameters_configurator 
kill $rem1
kill $rem2
kill $rem3
kill $rem4
 rm results/spins.jvx
 rm results/spins.*.jvx
 rm results/spins_prim.jvx
 rm results/spins_prim.*.jvx
else
  rm results/graphic_parameters.set
fi
done
if test -f results/.graphic_parameters.set
then
cp results/.graphic_parameters.set results/graphic_parameters.set
fi

