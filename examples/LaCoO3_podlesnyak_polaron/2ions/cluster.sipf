#!MODULE=cluster
#<!--mcphase.sipf-->
#!structurefile=cluster.j

# in this example we do not need interactions out of the cluster
# thus we do not set I1,I2,I3 

# here should follow the description of cluster moments in terms
# of moments of the individual ions
$GJ=2;
# the individual moments
$M1_1=$I1_1->multiply_scalar($GJ);
$M1_2=$I1_2->multiply_scalar($GJ);
$M1_3=$I1_3->multiply_scalar($GJ);
$M2_1=$I2_1->multiply_scalar($GJ);
$M2_2=$I2_2->multiply_scalar($GJ);
$M2_3=$I2_3->multiply_scalar($GJ);

# the total moment
 $M1=$M1_1+$M2_1;
 $M2=$M1_2+$M2_2;
 $M3=$M1_3+$M2_3;

# for running mcdisp it is needed to define a interaction operator
$I1=$M1*$M2*$M3;
$I2=$M1+$M2+$M3;

