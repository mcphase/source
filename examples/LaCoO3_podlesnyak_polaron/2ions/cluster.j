# LaSrCoO3 polaron description according to Podlesnyak et al PRL 101 (2008) 247603
#<!--mcphase.mcphas.j-->
#
# Lattice Constants (A)
#! a=7.7 b=7.7 c=7.7 alpha=  90 beta=  90 gamma=  90
#! r1a= 1 r2a= 0 r3a= 0
#! r1b= 0 r2b= 1 r3b= 0   primitive lattice vectors [a][b][c]
#! r1c= 0 r2c= 0 r3c= 1
#! nofatoms=2  nofcomponents=3  number of atoms in cluster unit cell/number of components of each spin
#*********************************************************************
#! da=   0 [a] db=   0 [b] dc=   0 [c] nofneighbours=1 diagonalexchange=1  sipffilename=Co4p.sipf
#da[a]   db[b]     dc[c]       Jaa[meV]  Jbb[meV]  Jcc[meV]  Jab[meV]  Jba[meV]  Jac[meV]  Jca[meV]  Jbc[meV]  Jcb[meV]
0 0  0.5 40 40 40
#*********************************************************************
#! da=   0 [a] db=   0 [b] dc=   0.5 [c] nofneighbours=1 diagonalexchange=1  sipffilename=Co3p.sipf
#da[a]   db[b]     dc[c]       Jaa[meV]  Jbb[meV]  Jcc[meV]  Jab[meV]  Jba[meV]  Jac[meV]  Jca[meV]  Jbc[meV]  Jcb[meV]
0 0 -0.5 40 40 40
