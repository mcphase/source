SCATTERINGLENGTHIMAG=0
CHARGE=3
nof_electrons=5
units=meV
conf=f5
F2=9696.1
F4=6314.0
F6=4626.5
zeta=307.92
R2=1.952E+00
R4=7.514
R6=5.210E+01
